        {
          "id": "74a90f82-c810-4c17-a533-0d5ee0275987",
          "name": "List Ratings",
          "request": {
            "name": "List Ratings",
            "description": {
              "content": "The ratings endpoint returns a list of BeZero ratings. Each page returns 100 ratings before it is paginated and the list is filterable by the `dataLastUpdatedAt` timestamp. Change to any of the data returned by ratings list or ratings details will update the `dataLastUpdatedAt` timestamp. You can filter the list using `changedSince` to only return any changes that may have occurred since the last query, to minimise API calls. `queryLatestChanges` is provided at the end of each paginated page to provide a timestamp of when the API was last called. BeZero ratings can change or be put on watch at any time and so polling for updates at least once per day is recommended.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ratings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "changedSince",
                  "value": "<string>",
                  "description": "optional ISO 8601 datetime string, when provided will filter out ratings where the data has not changed since provided date"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "optional pagination value"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional compatibility version. If omitted, the API defaults to `3.0` behavior.\n",
                "key": "Accept-API-Version",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "bcm/v3.ratings:list bcm/v3.ratings:details bcm/v3.ratings:riskFactors bcm/v3.projects:list"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://login.bezerocarbonmarkets.com/oauth2/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
          "response": [
