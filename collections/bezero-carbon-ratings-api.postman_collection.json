              "body": "{\n  \"ratings\": [\n    {\n      \"id\": \"string\",\n      \"projectID\": \"string\",\n      \"accreditor\": \"string\",\n      \"registryID\": \"string\",\n      \"vintages\": [\n        {\n          \"startDate\": \"string\",\n          \"endDate\": \"string\"\n        },\n        {\n          \"startDate\": \"string\",\n          \"endDate\": \"string\"\n        }\n      ],\n      \"rating\": \"Withdrawn\",\n      \"onRatingsWatch\": true,\n      \"summaryAnalysis\": \"string\",\n      \"platformURL\": \"string\",\n      \"dataLastUpdatedAt\": \"string\",\n      \"links\": {\n        \"ratingDetails\": \"string\",\n        \"riskFactors\": \"string\"\n      }\n    },\n    {\n      \"id\": \"string\",\n      \"projectID\": \"string\",\n      \"accreditor\": \"string\",\n      \"registryID\": \"string\",\n      \"vintages\": [\n        {\n          \"startDate\": \"string\",\n          \"endDate\": \"string\"\n        },\n        {\n          \"startDate\": \"string\",\n          \"endDate\": \"string\"\n        }\n      ],\n      \"rating\": \"AAA\",\n      \"onRatingsWatch\": true,\n      \"summaryAnalysis\": \"string\",\n      \"platformURL\": \"string\",\n      \"dataLastUpdatedAt\": \"string\",\n      \"links\": {\n        \"ratingDetails\": \"string\",\n        \"riskFactors\": \"string\"\n      }\n    }\n  ],\n  \"links\": {\n    \"queryLatestChanges\": \"string\",\n    \"nextPage\": \"string\",\n    \"prevPage\": \"string\"\n  }\n}",
